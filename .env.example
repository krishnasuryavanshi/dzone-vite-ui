# Backend API URL — gateway for direct service calls
VITE_API_URL=https://dzone-dev2.digitalzoneus.com

# Application environment
VITE_APP_ENV=development

# Encryption secret (replaces NEXTAUTH_SECRET / NEXT_PUBLIC_SECRET)
VITE_SECRET_KEY=

# Optional: Analytics
VITE_GA_TRACKING_ID=
VITE_CLARITY_TRACKING_ID=

# Auth session timeout (days)
VITE_AUTH_SESSION_TIMEOUT=1

# Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
