# Backend API URL — empty means relative URLs, proxied by Vite dev server to VITE_BACKEND_URL
VITE_API_URL=
# Next.js backend running on port 3000 (used by Vite dev proxy)
VITE_BACKEND_URL=http://localhost:3000

# Application environment
VITE_APP_ENV=development

# Encryption secret (replaces NEXTAUTH_SECRET / NEXT_PUBLIC_SECRET)
VITE_SECRET_KEY=OtMI5ObBzyKesSMKmvmrULJysufBkoJ65GK18HkPyCw=

# Optional: Analytics
VITE_GA_TRACKING_ID=
VITE_CLARITY_TRACKING_ID=

# Auth session timeout (days)
VITE_AUTH_SESSION_TIMEOUT=1
