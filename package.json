    "@types/node": "^25.3.3",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "rollup-plugin-visualizer": "^7.0.0",
    "sass": "^1.74.1",
    "typescript": "^5.6.0",
